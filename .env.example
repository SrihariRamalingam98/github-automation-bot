# Keep this file free of real credentials. Copy to .env for local development only.
APP_URL=http://localhost:4200
# Optional public HTTPS origin forwarding to THIS backend (e.g. a tunnel to port 3000).
# Required for local repository connections; defaults to APP_URL when blank.
# Keep APP_URL as the frontend/OAuth origin. No /webhooks path on this setting.
WEBHOOK_BASE_URL=
PORT=3000
NODE_ENV=development
# Default proxy trust: 0 hops in development, 1 in production.
# Set to the exact trusted ingress hop count; never expose a trusted-proxy listener directly.
# TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Production always requires verified TLS, even when this flag/URL says otherwise.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
# Exactly 64 hexadecimal characters; retain the existing key to decrypt stored tokens.
ENCRYPTION_KEY=
# Optional. Slack incoming webhook URL stays server-side.
SLACK_WEBHOOK_URL=
WORKER_ENABLED=true
# Total processing attempts per event, including the initial attempt (1-100).
# Default 5 = initial attempt plus up to 4 retries; existing counts are preserved.
EVENT_MAX_ATTEMPTS=5
# Optional disposable test database; never use production for integration tests.
TEST_DATABASE_URL=

# Application startup does not migrate. Review and run npm run db:migrate explicitly.
# TypeORM migration:show may create its ledger; do not treat db:migrations as read-only.
# After pruning build tools, use compiled workspace db:* scripts only after authorization.
# npm run db:check-schema inspects metadata read-only; never put production credentials in tests.

# Frontend development runs on port 4200 and proxies API/auth calls to backend port 3000.
# Restart npm run dev after changing .env; the compiler-driven runner does not watch this file.
# APP_URL must match the public frontend origin; no credentials belong in Angular configuration.
# Render: NODE_ENV=production, APP_URL=the existing public HTTPS origin, DATABASE_SSL=true.
# WEBHOOK_BASE_URL should be blank or that same HTTPS origin, never a local tunnel.
# Confirm TRUST_PROXY_HOPS=1 matches ingress; Render provides PORT. Keep EVENT_MAX_ATTEMPTS=5.
# Preserve existing signing/encryption keys. Disable WORKER_ENABLED for an intentionally paused
# HTTP-only smoke phase, then enable it explicitly for automation after release approval.
